<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleIdentifier</key><string>com.ip-guard.desktop.filter</string>
  <key>CFBundleExecutable</key><string>IPGuardFilter</string>
  <key>CFBundleName</key><string>IPGuardFilter</string>
  <key>CFBundleDisplayName</key><string>IP Guard Network Filter</string>
  <key>CFBundlePackageType</key><string>SYSX</string>
  <key>CFBundleVersion</key><string>@VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>13.0</string>
  <key>NSSystemExtensionUsageDescription</key><string>Only allow selected Claude and ChatGPT applications when their independently locked IP checks pass.</string>
  <key>NetworkExtension</key><dict>
    <key>NEMachServiceName</key><string>@TEAM@.com.ip-guard.desktop.policy</string>
    <key>NEProviderClasses</key><dict>
      <key>com.apple.networkextension.filter-data</key><string>IPGuardFilter.FilterDataProvider</string>
    </dict>
  </dict>
</dict></plist>
